<mujoco model="TWIPR">
    <option	timestep="0.001" gravity="0 0 -9.81" />
    <asset>
        <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1=".25 .25 .25" rgb2=".2 .2 .2"/>
        <material name="grid" texture="grid" texrepeat="1 1" texuniform="true" reflectance=".2"/>   
    </asset>

    <worldbody>
        <geom name="floor" pos="0 0 0" size="0 0 .05" type="plane" material="grid" condim="3"/>
        <light pos="0 0 10" dir="0 0 -1" directional="true"/>
        <body name="base" pos="0 0 0.354">
            <joint type="free"/>
            <inertial mass="1" pos="0.36 0 0" diaginertia="0.001172 0.001172 0.001172"/>
            <body name="wheel_L" pos="0 0 0" euler="-90 0 0">
                <geom type="cylinder" size="0.254 0.01" euler="0 90 0" rgba="0.5 0.1 0.1 1" />
                <joint name="gear1_L" type="hinge" axis="-1 0 0" damping="1"/>
                <body name="wheel_shaft_L" pos="0 0 0" euler="0 90 0">
                    <geom type="cylinder" pos="0 0 0.033" size="0.01 0.033" rgba="0 0 0 1"/>
                    <geom name="gear1_L" type="cylinder" pos="0 0 0.03" size="0.06 0.005"/>
                </body>
            </body>
            <body name="support_L" pos="0.05 0 0" euler="-90 90 0">
                <geom type="box" pos="0 0.09815 0" size="0.015 0.11 0.005" rgba="0.1 0.4 0.5 1"/>
                <joint name="rev2_L" type="hinge" damping="5"/>
                <body name="link_L" pos="0 0.1963 -0.02">
                    <geom type="cylinder" pos="0 0 0.04" size="0.01 0.04" rgba="0 0 0 1"/>
                    <joint name="link_jointL" pos="0 0 0.04" type="hinge" axis="0 0 -1" damping="5"/>
                    <body name="b3" euler="180 90 0">
                        <!-- <joint name="rev3" type="hinge" pos="0.36 0 0" axis="1 0 0" damping="5"/> -->
                       <geom name="body3" type="box" pos="0.36 0.56 0" size="0.3 0.56 0.05" rgba="0.1 0.8 0.3 1" contype="0" conaffinity="0"/>
                    </body>
                </body>
                <body name="motor_L" pos="0 0.1963 -0.02">
                    <joint name="gear2_L" pos="0 0 0.04" type="hinge" axis="0 0 -1" damping="5"/>
                    <geom type="cylinder" pos="0 0 0" size="0.02 0.005"/>
                </body>
            </body>
            <body name="wheel_R" pos="0.786 0 0" euler="-90 0 0">
                <geom type="cylinder" size="0.254 0.01" euler="0 90 0" rgba="0.5 0.1 0.1 1" />
                <joint name="gear1_R" type="hinge" axis="-1 0 0" damping="1"/>
                <body name="wheel_shaft_R" pos="0 0 0" euler="0 -90 0">
                    <geom type="cylinder" pos="0 0 0.033" size="0.01 0.033" rgba="0 0 0 1"/>
                    <geom name="gear1_R" type="cylinder" pos="0 0 0.03" size="0.06 0.005"/>
                </body>
            </body>
            <body name="support_R" pos="0.736 0 0" euler="-90 -90 0">
                <geom type="box" pos="0 0.09815 0" size="0.015 0.11 0.005" rgba="0.1 0.4 0.5 1"/>
                <joint name="rev2_R" type="hinge" damping="5"/>
                <body name="link_R" pos="0 0.1963 -0.02">
                    <geom type="cylinder" pos="0 0 0.04" size="0.01 0.04" rgba="0 0 0 1"/>
                    <joint name="link_jointR" pos="0 0 0.04" type="hinge" axis="0 0 -1" damping="5"/>
                </body>
                <body name="motor_R" pos="0 0.1963 -0.02">
                    <joint name="gear2_R" pos="0 0 0.04" type="hinge" axis="0 0 -1" damping="5"/>
                    <geom type="cylinder" pos="0 0 0" size="0.02 0.005"/>
                </body>
            </body>
        </body>
    </worldbody>

    <contact>
        <exclude body1="wheel_R" body2="wheel_shaft_R"/>
        <exclude body1="wheel_L" body2="wheel_shaft_L"/>
        <exclude body1="support_R" body2="wheel_R"/>
        <exclude body1="support_L" body2="wheel_L"/>
        <exclude body1="support_R" body2="wheel_shaft_R"/>
        <exclude body1="support_L" body2="wheel_shaft_L"/>
        <exclude body1="support_R" body2="motor_R"/>
        <exclude body1="support_L" body2="motor_L"/>
        <exclude body1="support_R" body2="b3"/>
        <exclude body1="support_L" body2="b3"/>
        <exclude body1="motor_L" body2="b3"/>
        <exclude body1="motor_R" body2="b3"/>
        <exclude body1="link_L" body2="b3"/>
        <exclude body1="link_R" body2="b3"/>
        <exclude body1="link_L" body2="motor_L"/>
        <exclude body1="link_R" body2="motor_R"/>
    </contact>

    <actuator>
        <velocity name="motor_L" joint="gear2_L" gear="1" kv="10" forcerange="-255 255" ctrlrange="-255 255"/>
        <velocity name="motor_R" joint="gear2_R" gear="1" kv="10" forcerange="-255 255" ctrlrange="-255 255"/>
    </actuator>

    <equality>
        <joint name="belt_L" joint1="gear2_L" joint2="gear1_L" polycoef="0 3 0 0 0"/>
        <joint name="belt_R" joint1="gear2_R" joint2="gear1_R" polycoef="0 3 0 0 0"/>
        <connect name="connect_r" body1="link_R" body2="b3" anchor="0 0 0.08"/>
        <connect name="connect_l" body1="link_L" body2="b3" anchor="0 0 0.08"/>
    </equality>
</mujoco>